# Copy to .env and fill in for a real (non-sandbox) deployment.
# Not required to run this project locally -- see src/load_to_snowflake.py,
# which uses SQLite by default in this offline build.

# --- Snowflake (production warehouse) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_DATABASE=RENTAL_MARKETPLACE
SNOWFLAKE_SCHEMA=RAW

# --- AWS S3 (production raw layer) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_RAW_BUCKET=rental-marketplace-raw

# --- Power BI (if publishing to a Power BI workspace) ---
POWERBI_WORKSPACE_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
